# =============================================================================
# Nakshatra CDC — environment variables TEMPLATE
#
#   cp .env.example .env.local     # then fill in real values
#
# .env.local is git-ignored. NEVER commit real keys, passwords or secrets.
# Production values are set in the hosting provider's dashboard, not in files.
#
# Rule of thumb:
#   NEXT_PUBLIC_*  -> bundled into browser JavaScript. Must be safe to be public.
#   everything else -> server only. Never prefix a secret with NEXT_PUBLIC_.
# =============================================================================

# --- Public (browser-safe) ---------------------------------------------------
# Supabase Dashboard -> Project Settings -> API (or `npx supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The "publishable" key (sb_publishable_...). Older projects call it the "anon" key.
# It is safe in the browser ONLY because every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Public base URL of this app (used for auth email links / redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (SECRET) -----------------------------------------------------
# The "secret" key (sb_secret_...). Older projects call it the "service_role" key.
# It BYPASSES Row Level Security. Server code only (src/lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=replace-with-your-secret-key

# --- Future steps (do not fill in yet) ----------------------------------------
# Step 10 — outgoing email for notifications / payment reminders
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=
# Step 9+ — online payment gateway (only if the center decides to accept online payments)
# PAYMENT_GATEWAY_KEY_ID=
# PAYMENT_GATEWAY_KEY_SECRET=
# PAYMENT_GATEWAY_WEBHOOK_SECRET=
